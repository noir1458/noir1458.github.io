---
import { FEATURES, NAVIGATION, SITE } from "@/config";

const footerLinks = NAVIGATION.footer.filter(
  (link) => !link.requiresFeature || FEATURES[link.requiresFeature]
);
---

<footer class="site-footer">
  <div class="footer-identity">
    <a href="/" class="footer-title">{SITE.title}</a>
    <p>{SITE.description}</p>
    <span>© {new Date().getFullYear()} {SITE.author.name}</span>
  </div>
  <nav aria-label="Footer navigation">
    {footerLinks.map((link) => (
      <a
        href={link.href}
        rel={link.external ? "noopener noreferrer" : undefined}
        target={link.external ? "_blank" : undefined}
      >
        {link.label}
      </a>
    ))}
  </nav>
</footer>
