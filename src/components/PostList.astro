---
import type { PostEntry } from "@/utils/content";
import {
  formatDate,
  postDescription,
  postUrl,
  slugifyTerm
} from "@/utils/content";

interface Props {
  posts: PostEntry[];
  headingLevel?: "h2" | "h3";
}

const { posts, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
const entries = posts.map((post) => ({
  post,
  description: postDescription(post)
}));
---

<div class="post-list" data-pagefind-ignore>
  {entries.map(({ post, description }) => (
    <article class="post-row">
      <div class="post-row-category">
        {post.data.categories[0] && (
          <a href={`/categories/${slugifyTerm(post.data.categories[0])}/`}>
            {post.data.categories[0]}
          </a>
        )}
      </div>
      <div class="post-row-copy">
        <Heading class="post-row-title">
          <a href={postUrl(post)}>{post.data.title}</a>
        </Heading>
        <p class="post-row-description">{description}</p>
      </div>
      <div class="post-row-meta">
        <time datetime={post.data.publishedAt.toISOString()}>
          {formatDate(post.data.publishedAt)}
        </time>
        <span class="post-row-arrow" aria-hidden="true">↗</span>
      </div>
    </article>
  ))}
</div>
