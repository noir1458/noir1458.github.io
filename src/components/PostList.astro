---
import { Image } from "astro:assets";
import type { PostEntry } from "@/utils/content";
import TermLabel from "@/components/TermLabel.astro";
import {
  formatDate,
  postDescription,
  postThumbnail,
  postUrl,
  slugifyTerm
} from "@/utils/content";

interface Props {
  posts: PostEntry[];
  headingLevel?: "h2" | "h3";
  showCategory?: boolean;
}

const { posts, headingLevel = "h2", showCategory = true } = Astro.props;
const Heading = headingLevel;
const entries = posts.map((post) => ({
  post,
  description: postDescription(post),
  thumbnail: postThumbnail(post)
}));
---

<div class="post-list" data-pagefind-ignore>
  {entries.map(({ post, description, thumbnail }) => (
    <article class="post-row">
      <div class="post-row-copy">
        <Heading class="post-row-title">
          <a href={postUrl(post)}>{post.data.title}</a>
        </Heading>
        <div class="post-row-meta">
          {showCategory && post.data.categories[0] && (
            <a class="post-row-category" href={`/categories/${slugifyTerm(post.data.categories[0])}/`}>
              <TermLabel name={post.data.categories[0]} />
            </a>
          )}
          <time datetime={post.data.publishedAt.toISOString()}>
            {formatDate(post.data.publishedAt)}
          </time>
        </div>
        <p class="post-row-description">{description}</p>
      </div>
      <a class="post-thumbnail" href={postUrl(post)} tabindex="-1" aria-hidden="true">
        {thumbnail && (
          typeof thumbnail === "string" ? (
            <img src={thumbnail} alt="" width="360" height="240" loading="lazy" decoding="async" />
          ) : (
            <Image
              src={thumbnail}
              alt=""
              width={360}
              height={240}
              widths={[180, 360]}
              sizes="(max-width: 360px) 72px, (max-width: 700px) 88px, (max-width: 1080px) 160px, 180px"
              fit="cover"
              loading="lazy"
              decoding="async"
            />
          )
        )}
      </a>
    </article>
  ))}
</div>

<script>
  const hideFailedThumbnail = (image: HTMLImageElement) => {
    if (image.complete && image.naturalWidth === 0) image.hidden = true;
  };

  document.addEventListener("error", (event) => {
    if (event.target instanceof HTMLImageElement && event.target.matches(".post-thumbnail img")) {
      hideFailedThumbnail(event.target);
    }
  }, true);

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLImageElement>(".post-thumbnail img").forEach(hideFailedThumbnail);
  });
</script>
