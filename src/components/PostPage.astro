---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import Giscus from "@/components/Giscus.astro";
import { SITE } from "@/config";
import {
  formatDate,
  getAllPublishedPosts,
  getPostTranslations,
  getPublishedPosts,
  postCover,
  postDescription,
  postUrl,
  slugifyTerm,
  type PostEntry
} from "@/utils/content";

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const allPosts = await getAllPublishedPosts();
const languagePosts = await getPublishedPosts(post.data.lang);
const index = languagePosts.findIndex((entry) => entry.id === post.id);
const newer = index > 0 ? languagePosts[index - 1] : undefined;
const older = index >= 0 && index < languagePosts.length - 1
  ? languagePosts[index + 1]
  : undefined;
const translations = getPostTranslations(post, allPosts);
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const canonical = new URL(postUrl(post), SITE.url).toString();
const cover = postCover(post);
const description = postDescription(post);
const coverUrl = cover
  ? new URL(cover.src, SITE.url).toString()
  : undefined;
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description,
  inLanguage: post.data.lang,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  mainEntityOfPage: canonical,
  url: canonical,
  author: {
    "@type": "Person",
    name: SITE.author.name,
    url: SITE.author.github
  },
  publisher: {
    "@type": "Person",
    name: SITE.author.name
  },
  keywords: post.data.categories.join(", "),
  ...(coverUrl ? { image: coverUrl } : {})
};
---

<BaseLayout
  title={post.data.title}
  description={description}
  image={coverUrl}
  language={post.data.lang}
  translations={translations}
  ogType="article"
  pagefindBody
  schema={schema}
>
  <div
    class="reading-progress"
    role="progressbar"
    aria-label="Reading progress"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    data-reading-progress
  >
    <span></span>
  </div>

  <article>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/" aria-label="Home"><Icon name="home" size={18} /></a>
      {post.data.categories[0] && (
        <>
          <Icon name="chevron-right" size={16} />
          <a href={`/categories/${slugifyTerm(post.data.categories[0])}/`}>
            <Icon name="category" size={17} />
            {post.data.categories[0]}
          </a>
        </>
      )}
    </nav>

    <header class="article-header">
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      <div class="article-meta">
        <span>
          <Icon name="calendar" size={20} />
          <time datetime={post.data.publishedAt.toISOString()}>
            {formatDate(post.data.publishedAt, undefined, post.data.lang)}
          </time>
        </span>
        {post.data.updatedAt && (
          <span>Updated {formatDate(post.data.updatedAt, undefined, post.data.lang)}</span>
        )}
        <span>
          <Icon name="clock" size={18} />
          {Math.max(1, Math.ceil((post.body ?? "").split(/\s+/u).length / 260))} min read
        </span>
        {post.data.tags.length > 0 && (
          <span class="article-meta-tags" data-pagefind-ignore>
            <Icon name="tag" size={18} />
            <span class="article-meta-tag-list">
              {post.data.tags.map((tag) => (
                <a href={`/tags/${slugifyTerm(tag)}/`}>{tag}</a>
              ))}
            </span>
          </span>
        )}
      </div>
    </header>

    {tocHeadings.length > 0 && (
      <details class="article-toc" open>
        <summary>On this page</summary>
        <ol>
          {tocHeadings.map((heading) => (
            <li class={`depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </details>
    )}

    <div class="article-content" data-pagefind-body data-reading-article>
      <Content />
    </div>

    <nav class="post-navigation" aria-label="Post navigation" data-pagefind-ignore>
      {newer ? (
        <a href={postUrl(newer)} title={newer.data.title}>
          <Icon name="arrow-left" size={18} /> Newer
        </a>
      ) : <span></span>}
      <a class="all-posts" href="/"><Icon name="menu" size={18} /> All posts</a>
      {older ? (
        <a href={postUrl(older)} title={older.data.title}>
          Older <Icon name="arrow-right" size={18} />
        </a>
      ) : <span></span>}
    </nav>

    <Giscus language={post.data.lang} />
  </article>

  <button class="scroll-top icon-button" type="button" aria-label="Back to top" data-scroll-top>
    <Icon name="arrow-up" size={21} />
  </button>

  <script>
    import "@/scripts/article-tools";
  </script>
</BaseLayout>
