---
import { getImage } from "astro:assets";
import { render } from "astro:content";
import { renderSVG } from "uqr";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import TermLabel from "@/components/TermLabel.astro";
import Giscus from "@/components/Giscus.astro";
import { FEATURES, SITE } from "@/config";
import {
  formatDate,
  getPublishedPosts,
  postCover,
  postDescription,
  postUrl,
  slugifyTerm,
  type PostEntry
} from "@/utils/content";

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const posts = await getPublishedPosts();
const index = posts.findIndex((entry) => entry.id === post.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 && index < posts.length - 1
  ? posts[index + 1]
  : undefined;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const canonical = new URL(postUrl(post), SITE.url).toString();
const printQr = renderSVG(canonical, { ecc: "M", border: 4, pixelSize: 1 });
const cover = postCover(post);
const description = postDescription(post);
// Link previews get a resized JPEG; the original upload can be several megabytes.
const socialCover = cover
  ? await getImage({
      src: cover,
      width: Math.min(cover.width, 1200),
      format: "jpeg",
      background: "#ffffff"
    })
  : undefined;
const coverUrl = socialCover
  ? new URL(socialCover.src, SITE.url).toString()
  : undefined;
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description,
  inLanguage: SITE.language,
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  mainEntityOfPage: canonical,
  url: canonical,
  author: {
    "@type": "Person",
    name: SITE.author.name,
    ...(SITE.author.url ? { url: SITE.author.url } : {})
  },
  publisher: {
    "@type": "Person",
    name: SITE.author.name
  },
  keywords: post.data.categories.join(", "),
  ...(coverUrl ? { image: coverUrl } : {})
};
---

<BaseLayout
  title={post.data.title}
  description={description}
  image={coverUrl}
  ogType="article"
  pagefindBody
  schema={schema}
  fullWidth
>
  <div
    class="reading-progress"
    role="progressbar"
    aria-label="Reading progress"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    data-reading-progress
  >
    <span></span>
  </div>

  <article>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Posts</a>
      {post.data.categories[0] && (
        <>
          <span aria-hidden="true">/</span>
          <a href={`/categories/${slugifyTerm(post.data.categories[0])}/`}>
            <TermLabel name={post.data.categories[0]} />
          </a>
        </>
      )}
    </nav>

    <header class="article-header">
      <a
        class="print-qr"
        href={canonical}
        aria-label={`Open original article: ${canonical}`}
        data-pagefind-ignore
      >
        <Fragment set:html={printQr} />
      </a>
      <p class="print-categories" data-pagefind-ignore>
        {post.data.categories.map((category, index) => (
          <Fragment>
            {index > 0 && <span aria-hidden="true"> · </span>}
            <a href={`/categories/${slugifyTerm(category)}/`}><TermLabel name={category} /></a>
          </Fragment>
        ))}
      </p>
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      <div class="article-meta">
        <span class="article-meta-item">
          <time datetime={post.data.publishedAt.toISOString()}>
            {formatDate(post.data.publishedAt)}
          </time>
        </span>
        {post.data.updatedAt && (
          <span class="article-meta-item" title="Updated">
            <span aria-hidden="true">Updated</span>
            <span class="sr-only">Updated </span>
            <time datetime={post.data.updatedAt.toISOString()}>
              {formatDate(post.data.updatedAt)}
            </time>
          </span>
        )}
        <span class="article-meta-item">
          {Math.max(1, Math.ceil((post.body ?? "").split(/\s+/u).length / 260))} min read
        </span>
        {post.data.tags.length > 0 && (
          <span class="article-meta-tags" data-pagefind-ignore>
            <span class="article-meta-tag-list">
              {post.data.tags.map((tag) => (
                <a href={`/tags/${slugifyTerm(tag)}/`}>{tag}</a>
              ))}
            </span>
          </span>
        )}
      </div>
    </header>

    <div class="article-content" data-pagefind-body data-reading-article>
      <Content />
    </div>

    <nav class="post-navigation" aria-label="Post navigation" data-pagefind-ignore>
      {newer ? (
        <a href={postUrl(newer)} title={newer.data.title}>
          <Icon name="arrow-left" size={18} /> Newer
        </a>
      ) : <span></span>}
      <a class="all-posts" href="/">All posts</a>
      {older ? (
        <a href={postUrl(older)} title={older.data.title}>
          Older <Icon name="arrow-right" size={18} />
        </a>
      ) : <span></span>}
    </nav>

    {FEATURES.comments && SITE.giscus && <Giscus />}
  </article>

  {FEATURES.tableOfContents && tocHeadings.length > 0 && (
    <dialog
      id="article-toc-dialog"
      class="article-toc-dialog"
      aria-labelledby="article-toc-title"
      data-article-toc-dialog
      data-pagefind-ignore
    >
      <nav class="article-toc-panel" aria-labelledby="article-toc-title" data-article-toc-panel>
        <h2 id="article-toc-title">On this page</h2>
        <button
          class="code-copy article-toc-close"
          type="button"
          aria-label="Close table of contents"
          title="Close"
          data-article-toc-close
        >
          <Icon name="close" size={16} />
        </button>
        <ol>
          {tocHeadings.map((heading) => (
            <li class={`depth-${heading.depth}`}>
              <a href={`#${heading.slug}`} data-article-toc-link>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </dialog>
  )}

  <dialog
    class="article-image-dialog"
    aria-label="Image preview"
    data-article-image-dialog
    data-pagefind-ignore
  >
    <figure data-article-image-panel>
      <button
        class="code-copy article-image-close"
        type="button"
        aria-label="Close image preview"
        title="Close"
        data-article-image-close
      >
        <Icon name="close" size={16} />
      </button>
      <img alt="" data-article-image-preview />
    </figure>
  </dialog>

  <div slot="floating" class="article-floating-tools" data-pagefind-ignore>
    {FEATURES.tableOfContents && tocHeadings.length > 0 && (
      <button
        class="article-toc-toggle icon-button"
        type="button"
        aria-label="Open table of contents"
        aria-controls="article-toc-dialog"
        aria-expanded="false"
        title="On this page"
        data-article-toc-toggle
      >
        <span class="article-toc-label">TOC</span>
      </button>
    )}
    <button class="scroll-top icon-button" type="button" aria-label="Back to top" data-scroll-top>
      <Icon name="arrow-up" size={21} />
    </button>
  </div>

  <script>
    import "@/scripts/article-tools";
  </script>
</BaseLayout>
