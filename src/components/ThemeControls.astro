---
import Icon from "@/components/Icon.astro";
---

<div class="theme-controls" aria-label="Color theme">
  <button class="icon-button" data-theme-value="light" type="button" aria-label="Use light theme" title="Light">
    <Icon name="sun" />
  </button>
  <button class="icon-button" data-theme-value="dark" type="button" aria-label="Use dark theme" title="Dark">
    <Icon name="moon" />
  </button>
  <button class="icon-button" data-theme-value="system" type="button" aria-label="Use system theme" title="System">
    <Icon name="system" />
  </button>
</div>
