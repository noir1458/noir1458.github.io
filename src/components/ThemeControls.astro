---
import Icon from "@/components/Icon.astro";
import { APPEARANCE } from "@/config";
const themes = [
  { value: "system", label: "Auto", icon: "system" },
  { value: "light", label: "Light", icon: "sun" },
  { value: "dark", label: "Dark", icon: "moon" }
] as const;
---

<section class="menu-appearance" data-appearance-picker aria-labelledby="menu-appearance-title">
  <h2 id="menu-appearance-title" class="menu-section-label">Appearance</h2>
  <div class="menu-appearance-controls" data-appearance-menu>
    <div class="menu-theme-options" role="group" aria-label="Color theme">
      {themes.map((theme) => (
        <button data-theme-value={theme.value} class:list={{ active: APPEARANCE.defaultTheme === theme.value }} type="button" aria-label={theme.label} title={theme.label} aria-pressed={APPEARANCE.defaultTheme === theme.value}>
          <Icon name={theme.icon} />
        </button>
      ))}
    </div>
    <label class="menu-accent-control" for="accent-hue">
      <span class="sr-only">Accent color</span>
      <input id="accent-hue" data-accent-hue type="range" min="0" max="360" step="1" value={APPEARANCE.accentHue} />
      <output data-accent-hue-output for="accent-hue">{APPEARANCE.accentHue}°</output>
    </label>
  </div>
</section>
