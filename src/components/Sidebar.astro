---
import type { PostEntry } from "@/utils/content";
import type { MarkdownHeading } from "astro";
import { groupCategoriesForSidebar } from "@/utils/content";
import Icon from "@/components/Icon.astro";
import { FEATURES, NAVIGATION } from "@/config";

interface Props {
  posts: PostEntry[];
  headings?: MarkdownHeading[];
}

const { posts, headings = [] } = Astro.props;
const categoryGroups = groupCategoriesForSidebar(posts);
const sidebarLinks = NAVIGATION.sidebar.filter(
  (link) => link.icon && (!link.requiresFeature || FEATURES[link.requiresFeature])
);
---

<div class="sidebar-region" data-sidebar-region>
  <button
    class="sidebar-toggle icon-button"
    data-sidebar-toggle
    type="button"
    aria-expanded="true"
    aria-label="Hide sidebar"
    aria-controls="blog-sidebar"
  >
    <Icon name="chevron-right" />
  </button>
  <aside id="blog-sidebar" class="sidebar" data-sidebar aria-label="Blog navigation">
    <nav class="sidebar-links" aria-label="Quick links">
      {sidebarLinks.map((link) => (
        <a
          class="sidebar-link icon-button"
          href={link.href}
          rel={link.external ? "noopener noreferrer" : undefined}
          target={link.external ? "_blank" : undefined}
          aria-label={link.label}
          title={link.label}
        >
          <Icon name={link.icon!} />
        </a>
      ))}
    </nav>

    {headings.length > 0 && (
      <details class="sidebar-widget article-sidebar-toc" open>
        <summary>
          <span>On this page</span>
          <Icon name="chevron-down" size={20} />
        </summary>
        <nav aria-label="On this page">
          <ol>
            {headings.map((heading) => (
              <li class={`depth-${heading.depth}`}>
                <a href={`#${heading.slug}`} data-article-toc-link>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    )}

    <details class="sidebar-widget" open={headings.length === 0}>
      <summary>
        <span>Categories</span>
        <Icon name="chevron-down" size={20} />
      </summary>
      <ul class="term-list">
        {categoryGroups.map((group, groupIndex) => (
          <Fragment>
            {groupIndex > 0 && (
              <li
                class="term-group-separator"
                data-automatic-group={group.automatic ? "true" : undefined}
                aria-hidden="true"
              />
            )}
            {group.categories.map((term) => (
              <li>
                <a href={`/categories/${term.slug}/`}>
                  <span>{term.name}</span>
                  <span class="term-count">{term.count}</span>
                </a>
              </li>
            ))}
          </Fragment>
        ))}
      </ul>
    </details>
  </aside>
</div>
