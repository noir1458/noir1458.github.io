---
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PROFILE, SITE, SOCIAL } from "@/config";

interface ProfileLink {
  label: string;
  href: string;
  icon?: "github" | "linkedin";
  external?: boolean;
}

const profileLinks: ProfileLink[] = [];
if (SOCIAL.github) {
  profileLinks.push({
    label: "GitHub",
    href: SOCIAL.github,
    icon: "github",
    external: true
  });
}
if (SOCIAL.linkedin) {
  profileLinks.push({
    label: "LinkedIn",
    href: SOCIAL.linkedin,
    icon: "linkedin",
    external: true
  });
}
if (SOCIAL.email) {
  profileLinks.push({
    label: "Email",
    href: `mailto:${SOCIAL.email}`
  });
}
if (SOCIAL.resume) {
  profileLinks.push({
    label: "CV",
    href: SOCIAL.resume,
    external: true
  });
}

const markdown = await createMarkdownProcessor({ syntaxHighlight: false });
const { code: profileHtml } = await markdown.render(PROFILE.body, {
  fileURL: new URL("../../config/profile.md", import.meta.url)
});

---

<BaseLayout
  title={PROFILE.data.title}
  description={PROFILE.data.subtitle ?? SITE.description}
  sidebar={false}
>
  <header class="page-heading">
    <span class="eyebrow">{PROFILE.data.eyebrow}</span>
    <div class="about-profile">
      <img
        class="profile-image"
        src={SITE.author.profileImage}
        alt={`${SITE.author.displayName} profile`}
        width="184"
        height="184"
      />
      <div class="about-profile-copy">
        <h1>{SITE.author.displayName}</h1>
        <div class="profile-copy" set:html={profileHtml} />
        {
          profileLinks.length > 0 && (
            <nav class="about-links" aria-label="Profile links">
              {profileLinks.map((link) => (
                <a
                  href={link.href}
                  data-icon={link.icon}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                >
                  {link.label}
                </a>
              ))}
            </nav>
          )
        }
      </div>
    </div>
  </header>
</BaseLayout>
