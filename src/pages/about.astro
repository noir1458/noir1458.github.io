---
import { getEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error("About page content was not found.");
}

---

<BaseLayout
  title={about.data.title}
  description={about.data.description}
  sidebar={false}
>
  <header class="page-heading">
    <span class="eyebrow">{about.data.eyebrow}</span>
    <h1>{about.data.heading}</h1>
    {about.data.lead && <p>{about.data.lead}</p>}
    {
      about.data.links.length > 0 && (
        <nav class="about-links" aria-label="Profile links">
          {about.data.links.map((link) => (
            <a
              href={link.href}
              data-icon={link.icon}
              target="_blank"
              rel="noreferrer"
            >
              {link.label}
            </a>
          ))}
        </nav>
      )
    }
  </header>
</BaseLayout>
