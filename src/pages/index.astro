---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import Pagination from "@/components/Pagination.astro";
import EmptyState from "@/components/EmptyState.astro";
import { SITE } from "@/config";
import { getPublishedPosts, paginatePosts } from "@/utils/content";

const allPosts = await getPublishedPosts();
const page = paginatePosts(allPosts, 1);
const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.title,
  url: SITE.url,
  description: SITE.description,
  inLanguage: SITE.language,
  author: {
    "@type": "Person",
    name: SITE.author.name,
    ...(SITE.author.url ? { url: SITE.author.url } : {})
  }
};
---

<BaseLayout schema={schema} sidebar={false} fullWidth>
  {page.posts.length ? (
    <>
      <header class="page-heading home-intro">
        <div>
          <span class="eyebrow">Computer science & notes</span>
          <h1>공부하고,<br />기록합니다.</h1>
        </div>
        <p>{SITE.description}</p>
      </header>
      <div class="list-toolbar">
        <nav aria-label="글 탐색">
          <a href="/" aria-current="page">전체 글</a>
          <a href="/categories/">카테고리</a>
          <a href="/archives/">아카이브</a>
        </nav>
        <p>{allPosts.length}개의 기록</p>
      </div>
      <PostList posts={page.posts} />
      <Pagination currentPage={page.currentPage} totalPages={page.totalPages} />
    </>
  ) : (
    <EmptyState />
  )}
</BaseLayout>
