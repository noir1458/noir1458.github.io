---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import EmptyState from "@/components/EmptyState.astro";
import Icon from "@/components/Icon.astro";
import Pagination from "@/components/Pagination.astro";
import { archivePages, archivePath } from "@/lib/content/archives";
import {
  formatDate,
  getPublishedPosts,
  groupPostsByYear,
  postUrl,
  type PostEntry
} from "@/utils/content";

interface Props {
  years: { year: number; count: number }[];
  allPostCount: number;
  year?: number;
  posts: PostEntry[];
  currentPage: number;
  totalPages: number;
  totalPosts: number;
  firstPost: number;
}

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  const groups = groupPostsByYear(posts);
  const years = groups.map(([year, entries]) => ({ year, count: entries.length }));
  const pages = archivePages(groups).map((page) => ({
    params: { archive: archivePath(page.year, page.currentPage).slice("/archives/".length, -1) },
    props: { ...page, years, allPostCount: posts.length }
  }));

  return [
    {
      params: { archive: undefined },
      props: pages[0]?.props ?? {
        years,
        allPostCount: 0,
        posts: [],
        currentPage: 1,
        totalPages: 0,
        totalPosts: 0,
        firstPost: 0
      }
    },
    ...pages
  ];
}) satisfies GetStaticPaths;

const { years, allPostCount, year, posts, currentPage, totalPages, totalPosts, firstPost } = Astro.props;
const title = year
  ? `Archives · ${year}${currentPage > 1 ? ` · Page ${currentPage}` : ""}`
  : "Archives";
---

<BaseLayout
  title={title}
  description={year ? `${year}년 게시글 ${totalPosts}개 · ${currentPage}/${totalPages}페이지` : "연도별로 모아보는 전체 게시글"}
  canonicalPath={year ? archivePath(year, currentPage) : undefined}
  fullWidth
>
  <header class="page-heading archive-heading">
    <span class="eyebrow">Chronology</span>
    <h1>Archives</h1>
    <p>{allPostCount} posts · {years.length} {years.length === 1 ? "year" : "years"}</p>
  </header>
  {year !== undefined ? (
    <>
      <section class="archive-selection" aria-labelledby="archive-year-title">
        <header class="archive-selection-heading">
          <h2 class="sr-only" id="archive-year-title">{year}</h2>
          <label class="archive-year-picker">
            <span class="sr-only">Archive year</span>
            <select name="year" data-archive-year-select>
              {years.map((entry) => (
                <option value={archivePath(entry.year)} selected={entry.year === year}>
                  {entry.year} · {entry.count} {entry.count === 1 ? "post" : "posts"}
                </option>
              ))}
            </select>
            <Icon name="chevron-down" size={18} />
          </label>
          <p class="archive-summary">
            <span>{firstPost}–{firstPost + posts.length - 1} of {totalPosts} posts</span>
            <span>Page {currentPage} of {totalPages}</span>
          </p>
        </header>
        <noscript>
          <style is:inline>.archive-year-picker { display: none; }</style>
          <nav class="archive-year-fallback" aria-label="Archive year">
            {years.map((entry) => (
              <a href={archivePath(entry.year)} aria-current={entry.year === year ? "true" : undefined}>
                {entry.year} · {entry.count}
              </a>
            ))}
          </nav>
        </noscript>
        <ol class="archive-posts" start={firstPost}>
          {posts.map((post) => (
            <li>
              <a href={postUrl(post)}>
                <time datetime={post.data.publishedAt.toISOString()}>
                  {formatDate(post.data.publishedAt, { includeYear: false })}
                </time>
                <span>{post.data.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
      <Pagination currentPage={currentPage} totalPages={totalPages} basePath={archivePath(year)} />
    </>
  ) : (
    <EmptyState headingLevel="h2" />
  )}
</BaseLayout>

<script>
  import { navigate } from "astro:transitions/client";

  function initArchiveYearPicker() {
    const select = document.querySelector<HTMLSelectElement>("[data-archive-year-select]");
    if (!select) return;
    const selected = select.querySelector<HTMLOptionElement>("option[selected]");
    if (selected) select.value = selected.value;
    if (select.dataset.initialized) return;
    select.dataset.initialized = "true";
    select.addEventListener("change", () => {
      void navigate(select.value);
    });
  }

  document.addEventListener("astro:page-load", initArchiveYearPicker);
  window.addEventListener("pageshow", initArchiveYearPicker);
</script>
