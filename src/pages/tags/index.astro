---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TermLabel from "@/components/TermLabel.astro";
import EmptyState from "@/components/EmptyState.astro";
import { countTerms, getPublishedPosts } from "@/utils/content";

const posts = await getPublishedPosts();
const tags = countTerms(posts, "tags");
---

<BaseLayout title="Tags" description="키워드별로 모아보는 게시글 태그" sidebar={false} fullWidth>
  <header class="page-heading">
    <span class="eyebrow">Index</span>
    <h1>Tags</h1>
    <p>Browse {tags.length} tags across {posts.length} published posts.</p>
  </header>
  {tags.length > 0 ? <div class="term-grid">
    {tags.map((tag) => (
      <a class="term-card" href={`/tags/${tag.slug}/`}>
        <TermLabel name={tag.name} />
        <span class="term-count">{tag.count}</span>
      </a>
    ))}
  </div> : (
    <EmptyState
      headingLevel="h2"
      title="No tags yet"
      description="Browse posts by category instead."
      href="/categories/"
      actionLabel="Browse categories"
    />
  )}
</BaseLayout>
