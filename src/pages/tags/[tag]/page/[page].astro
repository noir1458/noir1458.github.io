---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import Pagination from "@/components/Pagination.astro";
import { SITE } from "@/config";
import {
  countTerms,
  getPublishedPosts,
  paginatePosts,
  postsWithTerm,
  termNameFromSlug
} from "@/utils/content";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return countTerms(posts, "tags").flatMap((term) => {
    const count = postsWithTerm(posts, "tags", term.slug).length;
    const totalPages = Math.ceil(count / SITE.postsPerPage);
    return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
      params: { tag: term.slug, page: String(index + 2) }
    }));
  });
}) satisfies GetStaticPaths;

const tagSlug = Astro.params.tag!;
const currentPage = Number(Astro.params.page);
const allPosts = await getPublishedPosts();
const filtered = postsWithTerm(allPosts, "tags", tagSlug);
const tagName = termNameFromSlug(allPosts, "tags", tagSlug) ?? tagSlug;
const page = paginatePosts(filtered, currentPage);
---

<BaseLayout
  title={`${tagName} · Page ${page.currentPage}`}
  description={`${tagName} 태그 글 목록 ${page.currentPage}페이지`}
>
  <header class="page-heading">
    <span class="eyebrow">Tag</span>
    <h1>{tagName}</h1>
    <p>Page {page.currentPage} of {page.totalPages}</p>
  </header>
  <PostList posts={page.posts} />
  <Pagination
    currentPage={page.currentPage}
    totalPages={page.totalPages}
    basePath={`/tags/${tagSlug}/`}
  />
</BaseLayout>
