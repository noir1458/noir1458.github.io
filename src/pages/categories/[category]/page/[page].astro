---
import type { GetStaticPaths } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostList from "@/components/PostList.astro";
import Pagination from "@/components/Pagination.astro";
import { SITE } from "@/config";
import {
  countTerms,
  getPublishedPosts,
  paginatePosts,
  postsWithTerm,
  termNameFromSlug
} from "@/utils/content";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return countTerms(posts, "categories").flatMap((term) => {
    const count = postsWithTerm(posts, "categories", term.slug).length;
    const totalPages = Math.ceil(count / SITE.postsPerPage);
    return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
      params: { category: term.slug, page: String(index + 2) }
    }));
  });
}) satisfies GetStaticPaths;

const categorySlug = Astro.params.category!;
const currentPage = Number(Astro.params.page);
const allPosts = await getPublishedPosts();
const filtered = postsWithTerm(allPosts, "categories", categorySlug);
const categoryName =
  termNameFromSlug(allPosts, "categories", categorySlug) ?? categorySlug;
const page = paginatePosts(filtered, currentPage);
---

<BaseLayout
  title={`${categoryName} · Page ${page.currentPage}`}
  description={`${categoryName} 카테고리 글 목록 ${page.currentPage}페이지`}
>
  <header class="page-heading">
    <span class="eyebrow">Category</span>
    <h1>{categoryName}</h1>
    <p>Page {page.currentPage} of {page.totalPages}</p>
  </header>
  <PostList posts={page.posts} />
  <Pagination
    currentPage={page.currentPage}
    totalPages={page.totalPages}
    basePath={`/categories/${categorySlug}/`}
  />
</BaseLayout>
