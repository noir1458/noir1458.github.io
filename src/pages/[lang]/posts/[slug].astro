---
import type { GetStaticPaths } from "astro";
import PostPage from "@/components/PostPage.astro";
import { SITE, SUPPORTED_LANGUAGE_CODES } from "@/config";
import { getPublishedPosts } from "@/utils/content";

export const getStaticPaths = (async () => {
  const languages = SUPPORTED_LANGUAGE_CODES.filter((language) => language !== SITE.language);
  const posts = (await Promise.all(languages.map((language) => getPublishedPosts(language)))).flat();

  return posts.map((post) => ({
    params: { lang: post.data.lang, slug: post.data.slug },
    props: { post }
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
---

<PostPage post={post} />
