---
import "katex/dist/katex.min.css";
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import type { MarkdownHeading, TransitionDirectionalAnimations } from "astro";
import { APPEARANCE, FEATURES, LANGUAGES, SITE, type SupportedLanguage } from "@/config";
import Header from "@/components/Header.astro";
import Sidebar from "@/components/Sidebar.astro";
import Footer from "@/components/Footer.astro";
import { getPublishedPosts, type PostTranslation } from "@/utils/content";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  sidebar?: boolean;
  fullWidth?: boolean;
  pagefindBody?: boolean;
  ogType?: "website" | "article";
  schema?: Record<string, unknown>;
  language?: SupportedLanguage;
  translations?: PostTranslation[];
  sidebarHeadings?: MarkdownHeading[];
}

const {
  title,
  description = SITE.description,
  image,
  noindex = false,
  sidebar = true,
  fullWidth = false,
  pagefindBody = false,
  ogType = "website",
  schema,
  language = SITE.language,
  translations = [],
  sidebarHeadings = []
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, SITE.url);
const socialImage = new URL(image ?? SITE.socialImage, SITE.url);
const posts = sidebar ? await getPublishedPosts() : [];
const isProduction = import.meta.env.PROD;
const xDefaultTranslation =
  translations.find((translation) => translation.lang === SITE.language)
  ?? translations[0];
const contentAnimation = {
  old: {
    name: "page-content-out",
    duration: "70ms",
    easing: "cubic-bezier(0.4, 0, 1, 1)",
    fillMode: "both"
  },
  new: {
    name: "page-content-in",
    duration: "150ms",
    easing: "cubic-bezier(0.22, 1, 0.36, 1)",
    fillMode: "both"
  }
} as const;
const pageTransition: TransitionDirectionalAnimations = {
  forwards: contentAnimation,
  backwards: contentAnimation
};
---

<!doctype html>
<html
  lang={language}
  data-accent={APPEARANCE.accent}
  data-default-accent={APPEARANCE.accent}
  data-theme={FEATURES.darkMode ? "system" : "light"}
  data-theme-enabled={String(FEATURES.darkMode)}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161719" media="(prefers-color-scheme: dark)" />
    {SITE.googleVerification && (
      <meta name="google-site-verification" content={SITE.googleVerification} />
    )}
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    {FEATURES.rss && (
      <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    )}
    <link rel="icon" href={SITE.favicon} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={LANGUAGES[language].ogLocale} />
    {translations
      .filter((translation) => translation.lang !== language)
      .map((translation) => (
        <meta property="og:locale:alternate" content={LANGUAGES[translation.lang].ogLocale} />
      ))}
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={pageTitle} />
    {translations.map((translation) => (
      <link
        rel="alternate"
        hreflang={translation.lang}
        href={new URL(translation.href, SITE.url)}
      />
    ))}
    {translations.length > 1 && xDefaultTranslation && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(xDefaultTranslation.href, SITE.url)}
      />
    )}
    {pagefindBody && <meta data-pagefind-meta="language" content={language} />}
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const supportedAccents = ["cyan", "green", "purple", "rose"];
        let savedTheme = null;
        let savedAccent = null;
        let sidebarCollapsed = false;

        try {
          savedTheme = localStorage.getItem("color-theme");
          savedAccent = localStorage.getItem("color-accent");
          sidebarCollapsed = localStorage.getItem("sidebar-collapsed") === "true";
        } catch {}

        const defaultAccent = supportedAccents.includes(root.dataset.defaultAccent)
          ? root.dataset.defaultAccent
          : "cyan";
        root.dataset.accent = supportedAccents.includes(savedAccent)
          ? savedAccent
          : defaultAccent;

        if (root.dataset.themeEnabled === "true") {
          const theme = savedTheme === "neon"
            ? "dark"
            : savedTheme === "light" || savedTheme === "dark" || savedTheme === "system"
              ? savedTheme
              : "system";
          root.dataset.theme = theme;
          const resolved = theme === "system"
            ? window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light"
            : theme;
          root.dataset.resolvedTheme = resolved;
          root.style.colorScheme = resolved;
          if (savedTheme === "neon") {
            try { localStorage.setItem("color-theme", "dark"); } catch {}
          }
        } else {
          root.dataset.theme = "light";
          root.dataset.resolvedTheme = "light";
          root.style.colorScheme = "light";
        }
        root.dataset.sidebarCollapsed = String(
          window.matchMedia("(min-width: 961px)").matches && sidebarCollapsed
        );
        root.dataset.appearanceReady = "true";
      })();
    </script>
    <ClientRouter fallback="animate" />
    {!isProduction && (
      <script is:inline>
        (() => {
          if (!("serviceWorker" in navigator) || !("caches" in window)) return;

          const reloadMarker = "astro-blog-dev-cache-cleaned";
          Promise.all([navigator.serviceWorker.getRegistrations(), caches.keys()])
            .then(async ([registrations, cacheNames]) => {
              const blogCaches = cacheNames;
              if (registrations.length === 0 && blogCaches.length === 0) {
                sessionStorage.removeItem(reloadMarker);
                return;
              }

              await Promise.all([
                ...registrations.map((registration) => registration.unregister()),
                ...blogCaches.map((name) => caches.delete(name))
              ]);

              if (sessionStorage.getItem(reloadMarker) !== "true") {
                sessionStorage.setItem(reloadMarker, "true");
                location.reload();
              }
            })
            .catch((error) => console.warn("Unable to clear the development cache.", error));
        })();
      </script>
    )}
    {
      schema && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema).replaceAll("<", "\\u003c")}
        />
      )
    }
    <slot name="head" />
  </head>
  <body
    data-pagefind-body={pagefindBody ? "" : undefined}
    transition:name="page-shell"
    transition:animate="none"
  >
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <Header language={language} translations={translations} />
      <div
        class:list={[
          "content-grid",
          { "without-sidebar": !sidebar, "full-width-content": fullWidth }
        ]}
        data-layout
      >
        <main
          id="main-content"
          class="main-content"
          transition:name="page-content"
          transition:animate={pageTransition}
        >
          <slot />
        </main>
        {sidebar && <Sidebar posts={posts} headings={sidebarHeadings} />}
      </div>
      <slot name="floating" />
      <Footer />
    </div>
    <script>
      import "@/scripts/theme";
      import "@/scripts/navigation";
      import "@/scripts/service-worker";
    </script>
    {isProduction && SITE.analyticsId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.analyticsId}`}></script>
        <script is:inline define:vars={{ analyticsId: SITE.analyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag("js", new Date());
          gtag("config", analyticsId);
        </script>
      </>
    )}
  </body>
</html>
